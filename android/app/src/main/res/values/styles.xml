<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Default (system) — day/night split via values-night -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background_light</item>
        <item name="android:colorBackground">@color/splash_bg_light</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
        <item name="android:colorBackground">@color/splash_bg_light</item>
    </style>

    <!-- Explicit, system-independent variants — chosen by MainActivity based
         on the app's own saved theme preference. -->
    <style name="LaunchThemeLight" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background_light</item>
        <item name="android:colorBackground">@color/splash_bg_light</item>
    </style>
    <style name="LaunchThemeDark" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:colorBackground">@color/splash_bg</item>
    </style>
</resources>
