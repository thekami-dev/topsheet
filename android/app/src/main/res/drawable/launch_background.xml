<?xml version="1.0" encoding="utf-8"?>
<!-- Dark-premium splash: app icon centered-high, Thekami logo below it -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_bg" />
    <item android:bottom="140dp">
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher" />
    </item>
    <item android:gravity="bottom|center_horizontal" android:bottom="72dp">
        <bitmap
            android:gravity="center"
            android:src="@drawable/thekami_logo" />
    </item>
</layer-list>
